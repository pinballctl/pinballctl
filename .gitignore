/NOTES.md
/.local/
/.tmp-bin/
/gunicorn.ctl
/.claude

# Python environments, bytecode, packaging and test/tool caches.
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
