/dist/
/build/
/src/firmware/src/build/
/src/firmware/.pio/

# Godot editor/import cache; retain project sources and .uid files.
/src/godot/.godot/

# Keep only the instance README in git (configuration, media and logs are local).
/src/instance/*
!/src/instance/README
