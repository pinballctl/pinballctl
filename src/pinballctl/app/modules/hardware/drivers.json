{
  "defaults": {
    "drivers": ["Default"]
  },
  "functions": {
    "Button": {
      "notes": "Debounced input handled on ESP.",
      "drivers": [
        { "name": "Default" }
      ]
    },
    "LED": {
      "notes": "Single on/off output.",
      "drivers": [
        { "name": "Default" }
      ]
    },
    "Coil": {
      "notes": "Fire + hold logic / safety on ESP.",
      "drivers": [
        { "name": "Default" }
      ]
    },
    "RGB Strip": {
      "notes": "Addressable LEDs (FastLED on ESP).",
      "drivers": [
        { "name": "Default" }
      ]
    },
    "Accelerometer": {
      "notes": "Used by Gyro class / DMP.",
      "drivers": [
        {
          "name": "MMA8452",
          "label": "MMA8452 (GY-45)",
          "settings": [
            {
              "key": "i2cAddress",
              "label": "I2C Address",
              "type": "hex",
              "default": "0x1c",
              "min": 3,
              "max": 119,
              "help": "MMA8452 address (typically 0x1c or 0x1d)."
            },
            {
              "key": "tiltSensitivityMg",
              "label": "Tilt Sensitivity (mg)",
              "type": "number",
              "default": 350,
              "min": 50,
              "max": 4000,
              "help": "Higher values require a stronger jolt to emit TILT_NUDGE."
            },
            {
              "key": "liftAngleDeg",
              "label": "Lift Angle (deg)",
              "type": "number",
              "default": 20,
              "min": 5,
              "max": 89,
              "help": "Emit TILT_LIFTED when table angle exceeds this value."
            },
            {
              "key": "liftHysteresisDeg",
              "label": "Lift Hysteresis (deg)",
              "type": "number",
              "default": 5,
              "min": 1,
              "max": 30,
              "help": "Prevents TILT_LIFTED state chatter near the threshold."
            },
            {
              "key": "mountDirection",
              "label": "Mount Direction",
              "type": "select",
              "default": "Normal",
              "options": ["Normal", "Inverted"],
              "help": "Use Inverted when the module is mounted upside down."
            },
            {
              "key": "sampleMs",
              "label": "Sample Interval (ms)",
              "type": "number",
              "default": 25,
              "min": 10,
              "max": 1000,
              "help": "Polling interval for accelerometer reads."
            },
            {
              "key": "tiltCooldownMs",
              "label": "Tilt Cooldown (ms)",
              "type": "number",
              "default": 150,
              "min": 20,
              "max": 5000,
              "help": "Minimum time between TILT_NUDGE events."
            }
          ],
          "link": {
            "enabled": true,
            "roleField": "componentRole",
            "roles": ["SDA", "SCL"],
            "secondaryUidField": "secondaryPinUid",
            "linkedPrimaryField": "linkedPrimaryUid",
            "componentIdField": "componentId",
            "componentIdPrefix": "accel",
            "requirePinType": "GPIO"
          }
        }
      ]
    },
    "LCD Display": {
      "aliases": ["LCD1602"],
      "notes": "I2C character LCD (HD44780 compatible).",
      "drivers": [
        {
          "name": "LCD1602I2C",
          "label": "LCD1602I2C",
          "settings": [
            {
              "key": "i2cAddress",
              "label": "I2C Address",
              "type": "hex",
              "default": "0x27",
              "min": 3,
              "max": 119,
              "help": "Display backpack I2C address (commonly 0x27 or 0x3f)."
            },
            {
              "key": "lcdCols",
              "label": "Columns",
              "type": "number",
              "default": 16,
              "min": 8,
              "max": 40,
              "help": "Visible characters per line (typically 16)."
            },
            {
              "key": "lcdRows",
              "label": "Rows",
              "type": "number",
              "default": 2,
              "min": 1,
              "max": 4,
              "help": "Number of display lines (typically 2)."
            },
            {
              "key": "lcdAutoOffSec",
              "label": "Auto Off (seconds)",
              "type": "number",
              "default": 60,
              "min": 0,
              "max": 86400,
              "allowEmpty": true,
              "help": "Backlight auto-off timeout. Set 0 or leave empty to keep the display always on."
            }
          ],
          "link": {
            "enabled": true,
            "roleField": "componentRole",
            "roles": ["SDA", "SCL"],
            "secondaryUidField": "secondaryPinUid",
            "linkedPrimaryField": "linkedPrimaryUid",
            "componentIdField": "componentId",
            "componentIdPrefix": "lcd",
            "requirePinType": "GPIO"
          }
        }
      ]
    }
  }
}
