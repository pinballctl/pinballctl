{
  "schemaVersion": 1,
  "id": "pinballctl.feature-unlock",
  "name": "Feature unlock",
  "description": "Unlock a global logical feature once on an event, resetting its flag on GAME_STARTED.",
  "category": "Advanced gameplay",
  "icon": "bullseye",
  "author": "Pinball CTL",
  "version": "1.0.0",
  "minimumAppVersion": "0.10.0",
  "minimumRuntimeVersion": 2,
  "availability": "available",
  "prerequisites": [],
  "steps": [
    {
      "title": "Choose flag check",
      "fields": [
        {
          "id": "event",
          "label": "Event name",
          "type": "event",
          "default": "REWARD_REQUESTED",
          "help": "Exact event name. For hardware, use the mapped event base shown in Hardware. No scoring configuration is created."
        },
        {
          "id": "notification",
          "label": "Result event",
          "type": "event",
          "default": "FLAG_MATCHED"
        }
      ]
    }
  ],
  "rules": [
    {
      "name": "Feature unlock",
      "triggers": [
        {
          "type": "custom",
          "event": {
            "$answer": "event"
          }
        }
      ],
      "actions": [
        {
          "type": "emit_event",
          "params": {
            "name": {
              "$answer": "notification"
            }
          }
        },
        {
          "type": "set_flag",
          "target": {
            "$local": "UNLOCKED"
          },
          "params": {
            "value": true
          }
        }
      ],
      "conditions": [
        {
          "type": "flag",
          "key": {
            "$local": "UNLOCKED"
          },
          "op": "==",
          "value": false
        }
      ]
    },
    {
      "name": "Reset feature unlock",
      "triggers": [
        {
          "type": "system",
          "event": "GAME_STARTED"
        }
      ],
      "actions": [
        {
          "type": "set_flag",
          "target": {
            "$local": "UNLOCKED"
          },
          "params": {
            "value": false
          }
        }
      ]
    }
  ],
  "warnings": [
    "A logical flag and notification only. Does not enable a coil, game mode or physical mechanism. Global state; GAME_STARTED requires a real producer."
  ],
  "tags": []
}
