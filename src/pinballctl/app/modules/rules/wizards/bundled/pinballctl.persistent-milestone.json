{
  "schemaVersion": 1,
  "id": "pinballctl.persistent-milestone",
  "name": "Persistent milestone",
  "description": "Claim a global persistent counter milestone once; remember the claim across restarts.",
  "category": "Player / state",
  "icon": "flag",
  "author": "Pinball CTL",
  "version": "1.0.0",
  "minimumAppVersion": "0.10.0",
  "minimumRuntimeVersion": 2,
  "availability": "available",
  "prerequisites": [],
  "steps": [
    {
      "title": "Choose counter threshold",
      "fields": [
        {
          "id": "event",
          "label": "Event name",
          "type": "event",
          "default": "REWARD_REQUESTED",
          "help": "Exact event name. For hardware, use the mapped event base shown in Hardware. No scoring configuration is created."
        },
        {
          "id": "counter",
          "label": "Existing counter",
          "type": "counter"
        },
        {
          "id": "threshold",
          "label": "Threshold",
          "type": "integer",
          "min": 1,
          "max": 1000000,
          "default": 10
        },
        {
          "id": "notification",
          "label": "Result event",
          "type": "event",
          "default": "THRESHOLD_MATCHED"
        }
      ]
    }
  ],
  "rules": [
    {
      "name": "Persistent milestone",
      "triggers": [
        {
          "type": "custom",
          "event": {
            "$answer": "event"
          }
        }
      ],
      "actions": [
        {
          "type": "emit_event",
          "params": {
            "name": {
              "$answer": "notification"
            }
          }
        },
        {
          "type": "set_flag",
          "target": {
            "$local": "CLAIMED"
          },
          "params": {
            "value": true
          }
        }
      ],
      "conditions": [
        {
          "type": "counter",
          "key": {
            "$answer": "counter"
          },
          "op": ">=",
          "value": {
            "$answer": "threshold"
          }
        },
        {
          "type": "flag",
          "key": {
            "$local": "CLAIMED"
          },
          "op": "==",
          "value": false
        }
      ]
    }
  ],
  "warnings": [
    "One-time global milestone, not per player. The private claimed flag persists; edit an explicit reset rule if you need to award it again."
  ],
  "tags": []
}
