{
  "schemaVersion": 1,
  "id": "pinballctl.event-driven-media-scene",
  "name": "Event-driven media scene",
  "description": "Configure event-driven media scene using ordinary editable rules.",
  "category": "Media / lighting",
  "icon": "music",
  "author": "Pinball CTL",
  "version": "1.0.0",
  "minimumAppVersion": "0.10.0",
  "minimumRuntimeVersion": 2,
  "availability": "available",
  "prerequisites": [],
  "steps": [
    {
      "title": "Choose event and media",
      "fields": [
        {
          "id": "event",
          "label": "Event name",
          "type": "event",
          "default": "REWARD_REQUESTED",
          "help": "Exact event name. For hardware, use the mapped event base shown in Hardware. No scoring configuration is created."
        },
        {
          "id": "media",
          "label": "Existing media scene",
          "type": "media"
        }
      ]
    }
  ],
  "rules": [
    {
      "name": "Event-driven media scene",
      "triggers": [
        {
          "type": "custom",
          "event": {
            "$answer": "event"
          }
        }
      ],
      "actions": [
        {
          "type": "media_play_scene",
          "params": {},
          "target": {
            "$answer": "media"
          }
        }
      ],
      "conditions": []
    }
  ],
  "warnings": [],
  "tags": []
}
