{
  "triggers": {
    "hardware": {
      "description": "Physical hardware inputs from mapping.json",
      "deviceClasses": {
        "button": {
          "label": "Button",
          "events": [
            {
              "key": "CLICKED",
              "label": "Clicked"
            },
            {
              "key": "DOUBLE_CLICKED",
              "label": "Double Clicked",
              "params": [
                "windowMs"
              ]
            },
            {
              "key": "HELD",
              "label": "Held",
              "params": [
                "minMs"
              ]
            },
            {
              "key": "PRESSED",
              "label": "Pressed"
            },
            {
              "key": "RELEASED",
              "label": "Released"
            },
            {
              "key": "REPEAT_WHILE_HELD",
              "label": "Repeat While Held",
              "params": [
                "repeatMs"
              ]
            }
          ]
        },
        "switch": {
          "label": "Switch / Opto",
          "events": [
            {
              "key": "CLOSED",
              "label": "Closed"
            },
            {
              "key": "OPENED",
              "label": "Opened"
            },
            {
              "key": "CHANGED",
              "label": "Changed State"
            },
            {
              "key": "ACTIVE_FOR_MS",
              "label": "Active for Duration",
              "params": [
                "minMs"
              ]
            },
            {
              "key": "INACTIVE_FOR_MS",
              "label": "Inactive for Duration",
              "params": [
                "minMs"
              ]
            }
          ]
        },
        "accelerometer": {
          "label": "Tilt / Motion",
          "events": [
            {
              "key": "TILT_NUDGE",
              "label": "Nudge Detected"
            },
            {
              "key": "TILT_LIFTED",
              "label": "Table Lifted"
            }
          ]
        },
        "nfc": {
          "label": "NFC / RFID",
          "events": [
            {
              "key": "NFC_SCANNED",
              "label": "Tag Scanned"
            },
            {
              "key": "NFC_MATCHED",
              "label": "Known Tag Scanned",
              "params": [
                "tagIds"
              ]
            }
          ]
        }
      }
    },
    "system": {
      "description": "Predefined system and gameplay events",
      "categories": {
        "game": {
          "label": "Game",
          "events": [
            "GAME_STARTED",
            "GAME_ENDED",
            "BALL_STARTED",
            "BALL_ENDED",
            "PLAYER_ADDED"
          ]
        },
        "credits": {
          "label": "Credits",
          "events": [
            "CREDITS_CHANGED",
            "HAS_CREDIT_TRUE",
            "HAS_CREDIT_FALSE"
          ]
        },
        "modes": {
          "label": "Modes",
          "events": [
            "MODE_STARTED",
            "MODE_ENDED"
          ]
        },
        "system": {
          "label": "System",
          "events": [
            "BOOT_COMPLETED",
            "ENABLE_GRANTED",
            "ENABLE_REVOKED",
            "IDLE_ENTERED",
            "IDLE_EXITED"
          ]
        },
        "bridge": {
          "label": "Bridge / Connectivity",
          "events": [
            "BRIDGE_CONNECTED",
            "BRIDGE_DISCONNECTED",
            "CONFIG_SYNCED"
          ]
        },
        "faults": {
          "label": "Faults / Safety",
          "events": [
            "FAULT_RAISED",
            "FAULT_CLEARED",
            "WATCHDOG_TRIGGERED"
          ]
        }
      }
    },
    "custom": {
      "description": "User-defined custom events",
      "freeText": true,
      "validation": "^[A-Z0-9_]+$",
      "example": "START_GAME_REQUESTED"
    }
  },
  "conditions": {
    "flag": {
      "label": "Flag",
      "operators": [
        "=="
      ],
      "values": [
        true,
        false
      ],
      "flags": [
        "TILT",
        "ENABLED",
        "HAS_CREDIT",
        "GAME_ACTIVE",
        "BALL_IN_PLAY",
        "IDLE"
      ]
    },
    "counter": {
      "label": "Counter",
      "operators": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">="
      ],
      "counters": [
        "CREDITS",
        "BALL_NUMBER",
        "PLAYER_COUNT"
      ]
    },
    "time_since_event": {
      "label": "Time Since Event",
      "operators": [
        ">",
        ">=",
        "<",
        "<="
      ],
      "params": [
        "event",
        "valueMs"
      ]
    },
    "device_state": {
      "label": "Device State",
      "operators": [
        "=="
      ],
      "states": {
        "coil": [
          "ACTIVE",
          "INACTIVE"
        ],
        "switch": [
          "OPEN",
          "CLOSED"
        ],
        "output": [
          "HIGH",
          "LOW"
        ]
      }
    }
  },
  "actions": {
    "emit_event": {
      "label": "Emit Event",
      "params": [
        "event"
      ],
      "ui": {
        "module": "system",
        "pathKey": "system_emit_event",
        "actionLabel": "Fire Event",
        "fields": [
          {
            "bind": "params.eventType",
            "label": "Event Type",
            "kind": "select",
            "default": "system",
            "options": [
              {
                "value": "system",
                "label": "Predefined"
              },
              {
                "value": "custom",
                "label": "Custom"
              }
            ],
            "col": "col-12 col-lg-4"
          },
          {
            "bind": "params.source",
            "label": "Category",
            "kind": "select",
            "source": "system.categories",
            "placeholder": "Category…",
            "visibleWhen": {
              "bind": "params.eventType",
              "equals": "system"
            },
            "col": "col-12 col-lg-4"
          },
          {
            "bind": "target",
            "label": "Event",
            "kind": "select",
            "source": "system.events",
            "categoryBind": "params.source",
            "placeholder": "Event…",
            "required": true,
            "requiredMessage": "Select or enter an event.",
            "visibleWhen": {
              "bind": "params.eventType",
              "equals": "system"
            },
            "col": "col-12 col-lg-4"
          },
          {
            "bind": "target",
            "label": "Event",
            "kind": "event_name",
            "placeholder": "CUSTOM_EVENT",
            "required": true,
            "requiredMessage": "Select or enter an event.",
            "visibleWhen": {
              "bind": "params.eventType",
              "equals": "custom"
            },
            "col": "col-12 col-lg-8"
          }
        ]
      }
    },
    "set_flag": {
      "label": "Set Flag",
      "params": [
        "flag",
        "value"
      ],
      "ui": {
        "module": "system",
        "pathKey": "system_set_flag",
        "actionLabel": "Set Flag",
        "fields": [
          {
            "bind": "target",
            "label": "Flag",
            "kind": "select",
            "source": "conditions.flags",
            "placeholder": "Select flag…",
            "required": true,
            "requiredMessage": "Select a flag.",
            "col": "col-12 col-lg-6"
          },
          {
            "bind": "params.value",
            "label": "Value",
            "kind": "select",
            "valueType": "boolean",
            "default": true,
            "options": [
              {
                "value": "true",
                "label": "True"
              },
              {
                "value": "false",
                "label": "False"
              }
            ],
            "col": "col-12 col-lg-6"
          }
        ]
      }
    },
    "set_counter": {
      "label": "Set Counter",
      "params": [
        "counter",
        "value"
      ],
      "ui": {
        "module": "system",
        "pathKey": "system_set_counter",
        "actionLabel": "Set Counter",
        "fields": [
          {
            "bind": "target",
            "label": "Counter",
            "kind": "select",
            "source": "conditions.counters",
            "placeholder": "Select counter…",
            "required": true,
            "requiredMessage": "Select a counter.",
            "col": "col-12 col-lg-6"
          },
          {
            "bind": "params.value",
            "label": "Value",
            "kind": "number",
            "valueType": "integer",
            "col": "col-12 col-lg-6"
          }
        ]
      }
    },
    "inc_counter": {
      "label": "Increment Counter",
      "params": [
        "counter",
        "delta"
      ],
      "ui": {
        "module": "system",
        "pathKey": "system_inc_counter",
        "actionLabel": "Increment Counter",
        "fields": [
          {
            "bind": "target",
            "label": "Counter",
            "kind": "select",
            "source": "conditions.counters",
            "placeholder": "Select counter…",
            "required": true,
            "requiredMessage": "Select a counter.",
            "col": "col-12 col-lg-6"
          },
          {
            "bind": "params.delta",
            "label": "Delta",
            "kind": "number",
            "valueType": "integer",
            "default": 1,
            "col": "col-12 col-lg-6"
          }
        ]
      }
    },
    "pulse": {
      "label": "Pulse",
      "params": [
        "device",
        "durationMs"
      ],
      "targetSource": "hardware.outputs",
      "ui": {
        "module": "system",
        "pathKey": "system_pulse_output",
        "actionLabel": "Pulse Output",
        "fields": [
          {
            "bind": "target",
            "label": "Output",
            "kind": "select",
            "source": "hardware.outputs",
            "placeholder": "Select output…",
            "required": true,
            "requiredMessage": "Select an output or coil.",
            "col": "col-12 col-lg-6"
          },
          {
            "bind": "params.durationMs",
            "label": "Duration (ms)",
            "kind": "number",
            "valueType": "integer",
            "default": 30,
            "min": 1,
            "col": "col-12 col-lg-6"
          }
        ]
      }
    },
    "set_output": {
      "label": "Set Output",
      "params": [
        "device",
        "value"
      ],
      "targetSource": "hardware.outputs",
      "ui": {
        "module": "system",
        "pathKey": "system_set_output",
        "actionLabel": "Set Output",
        "fields": [
          {
            "bind": "target",
            "label": "Output",
            "kind": "select",
            "source": "hardware.outputs",
            "placeholder": "Select output…",
            "required": true,
            "requiredMessage": "Select an output or coil.",
            "col": "col-12 col-lg-6"
          },
          {
            "bind": "params.value",
            "label": "Value",
            "kind": "select",
            "default": "LOW",
            "options": [
              {
                "value": "HIGH",
                "label": "HIGH"
              },
              {
                "value": "LOW",
                "label": "LOW"
              }
            ],
            "col": "col-12 col-lg-6"
          }
        ]
      }
    },
    "apply_lighting_scene": {
      "label": "Apply Lighting Scene",
      "params": [
        "sceneId",
        "startAt",
        "startFrame",
        "startTag",
        "startMode"
      ],
      "targetSource": "lighting.scenes",
      "ui": {
        "module": "lighting",
        "pathKey": "lighting_apply",
        "actionLabel": "Play Scene",
        "fields": [
          {
            "bind": "target",
            "label": "Scene",
            "kind": "select",
            "source": "lighting.scenes",
            "placeholder": "Select scene…",
            "required": true,
            "requiredMessage": "Select a lighting scene.",
            "sync": [
              "params.sceneId"
            ],
            "col": "col-12 col-lg-6"
          },
          {
            "bind": "params.startMode",
            "label": "Start Mode",
            "kind": "select",
            "default": "play",
            "options": [
              {
                "value": "play",
                "label": "Play immediately"
              },
              {
                "value": "paused",
                "label": "Load paused"
              }
            ],
            "col": "col-12 col-lg-3"
          },
          {
            "bind": "params.startAt",
            "label": "Start At",
            "kind": "select",
            "default": "start",
            "options": [
              {
                "value": "start",
                "label": "Scene start"
              },
              {
                "value": "frame",
                "label": "Frame"
              },
              {
                "value": "tag",
                "label": "Tag"
              }
            ],
            "col": "col-12 col-lg-3"
          },
          {
            "bind": "params.startFrame",
            "label": "Frame",
            "kind": "number",
            "valueType": "integer",
            "default": 1,
            "min": 1,
            "required": true,
            "requiredMessage": "Enter a valid frame number.",
            "visibleWhen": {
              "bind": "params.startAt",
              "equals": "frame"
            },
            "col": "col-12 col-lg-3"
          },
          {
            "bind": "params.startTag",
            "label": "Tag",
            "kind": "select",
            "source": "lighting.tags",
            "sceneBind": "target",
            "placeholder": "Select tag…",
            "required": true,
            "requiredMessage": "Select a start tag.",
            "visibleWhen": {
              "bind": "params.startAt",
              "equals": "tag"
            },
            "col": "col-12 col-lg-3"
          }
        ]
      }
    },
    "stop_lighting_scene": {
      "label": "Stop Lighting Scene",
      "params": [
        "sceneId"
      ],
      "targetSource": "lighting.scenes",
      "ui": {
        "module": "lighting",
        "pathKey": "lighting_stop",
        "actionLabel": "Stop Scene",
        "fields": [
          {
            "bind": "target",
            "label": "Scene",
            "kind": "select",
            "source": "lighting.scenes",
            "placeholder": "Select scene…",
            "required": true,
            "requiredMessage": "Select a lighting scene.",
            "sync": [
              "params.sceneId"
            ],
            "col": "col-12 col-lg-8"
          }
        ]
      }
    },
    "set_lighting_pixels": {
      "label": "Target Pixels",
      "params": [
        "fixtureId",
        "pixelIndexes",
        "mode",
        "color",
        "brightness",
        "blinkCount",
        "blinkIntervalMs"
      ],
      "targetSource": "lighting.fixtures",
      "ui": {
        "module": "lighting",
        "pathKey": "lighting_target_pixels",
        "actionLabel": "Target Pixel",
        "fields": [
          {
            "bind": "target",
            "label": "Fixture",
            "kind": "select",
            "source": "lighting.fixtures",
            "placeholder": "Select fixture…",
            "required": true,
            "requiredMessage": "Select a lighting fixture.",
            "sync": [
              "params.fixtureId"
            ],
            "col": "col-12 col-lg-4"
          },
          {
            "bind": "params.pixelIndexes",
            "label": "Pixel Indexes",
            "kind": "text",
            "placeholder": "0,1,2",
            "required": true,
            "requiredMessage": "Select one or more pixel indexes.",
            "pattern": "^\\s*\\d+(\\s*,\\s*\\d+)*\\s*$",
            "patternMessage": "Use a comma-separated list of zero-based indexes, e.g. 0,1,2",
            "col": "col-12 col-lg-4"
          },
          {
            "bind": "params.mode",
            "label": "State",
            "kind": "select",
            "default": "on",
            "options": [
              {
                "value": "on",
                "label": "On"
              },
              {
                "value": "off",
                "label": "Off"
              },
              {
                "value": "blink",
                "label": "Blink"
              }
            ],
            "col": "col-12 col-lg-2"
          },
          {
            "bind": "params.color",
            "label": "Color",
            "kind": "color",
            "default": "#ffffff",
            "required": true,
            "requiredMessage": "Enter a valid hex color.",
            "col": "col-12 col-lg-2"
          },
          {
            "bind": "params.brightness",
            "label": "Brightness",
            "kind": "range",
            "valueType": "number",
            "default": 1.0,
            "min": 0,
            "max": 1,
            "step": 0.01,
            "col": "col-12 col-lg-2"
          },
          {
            "bind": "params.blinkCount",
            "label": "Blink Count",
            "kind": "number",
            "valueType": "integer",
            "default": 2,
            "min": 1,
            "max": 1000,
            "visibleWhen": {
              "bind": "params.mode",
              "equals": "blink"
            },
            "col": "col-12 col-lg-2"
          },
          {
            "bind": "params.blinkIntervalMs",
            "label": "Interval (ms)",
            "kind": "number",
            "valueType": "integer",
            "default": 150,
            "min": 10,
            "max": 60000,
            "visibleWhen": {
              "bind": "params.mode",
              "equals": "blink"
            },
            "col": "col-12 col-lg-2"
          },
          {
            "kind": "help_tokens",
            "label": "Pixel Indexes",
            "col": "col-12",
            "tokens": [
              {
                "token": "0,1,2",
                "summary": "Comma-separated, zero-based indexes."
              },
              {
                "token": "0",
                "summary": "Single pixel index."
              },
              {
                "token": "Blink Count = 1",
                "summary": "Equivalent to a pulse (on then off once)."
              }
            ]
          }
        ]
      }
    },
    "play_audio_cue": {
      "label": "Play Audio Cue",
      "params": [
        "cueId",
        "playMode"
      ],
      "targetSource": "audio.cues",
      "ui": {
        "module": "audio",
        "pathKey": "audio_play",
        "actionLabel": "Play Cue",
        "fields": [
          {
            "bind": "target",
            "label": "Audio Cue",
            "kind": "select",
            "source": "audio.cues",
            "placeholder": "Select cue…",
            "required": true,
            "requiredMessage": "Select an audio cue.",
            "sync": [
              "params.cueId"
            ],
            "col": "col-12 col-lg-8"
          },
          {
            "bind": "params.playMode",
            "label": "Playback",
            "kind": "select",
            "default": "layer",
            "options": [
              {
                "value": "layer",
                "label": "Layer (Recommended)"
              },
              {
                "value": "restart",
                "label": "Restart (Instant)"
              },
              {
                "value": "ignore",
                "label": "Ignore While Playing"
              }
            ],
            "col": "col-12 col-lg-4"
          }
        ]
      }
    },
    "stop_audio_cue": {
      "label": "Stop Audio Cue",
      "params": [
        "cueId"
      ],
      "targetSource": "audio.cues",
      "ui": {
        "module": "audio",
        "pathKey": "audio_stop",
        "actionLabel": "Stop Cue",
        "fields": [
          {
            "bind": "target",
            "label": "Audio Cue",
            "kind": "select",
            "source": "audio.cues",
            "placeholder": "Select cue…",
            "sync": [
              "params.cueId"
            ],
            "col": "col-12 col-lg-8"
          }
        ]
      }
    },
    "toggle_audio_cue": {
      "label": "Toggle Audio Cue",
      "params": [
        "cueId",
        "playMode"
      ],
      "targetSource": "audio.cues",
      "ui": {
        "module": "audio",
        "pathKey": "audio_toggle",
        "actionLabel": "Toggle Cue",
        "fields": [
          {
            "bind": "target",
            "label": "Audio Cue",
            "kind": "select",
            "source": "audio.cues",
            "placeholder": "Select cue…",
            "required": true,
            "requiredMessage": "Select an audio cue.",
            "sync": [
              "params.cueId"
            ],
            "col": "col-12 col-lg-8"
          },
          {
            "bind": "params.playMode",
            "label": "Playback",
            "kind": "select",
            "default": "layer",
            "options": [
              {
                "value": "layer",
                "label": "Layer (Recommended)"
              },
              {
                "value": "restart",
                "label": "Restart (Instant)"
              },
              {
                "value": "ignore",
                "label": "Ignore While Playing"
              }
            ],
            "col": "col-12 col-lg-4"
          }
        ]
      }
    },
    "media_play_scene": {
      "label": "Play Media Scene",
      "params": [
        "sceneId"
      ],
      "targetSource": "media.scenes",
      "ui": {
        "module": "media",
        "pathKey": "media_play",
        "actionLabel": "Play Scene",
        "fields": [
          {
            "bind": "target",
            "label": "Media Scene",
            "kind": "select",
            "source": "media.scenes",
            "placeholder": "Select scene…",
            "required": true,
            "requiredMessage": "Select a media scene.",
            "sync": [
              "params.sceneId"
            ],
            "col": "col-12 col-lg-8"
          }
        ]
      }
    },
    "media_stop_scene": {
      "label": "Stop Media Scene",
      "params": [
        "sceneId"
      ],
      "targetSource": "media.scenes",
      "ui": {
        "module": "media",
        "pathKey": "media_stop",
        "actionLabel": "Stop Scene",
        "fields": [
          {
            "bind": "target",
            "label": "Media Scene",
            "kind": "select",
            "source": "media.scenes",
            "placeholder": "Select scene…",
            "required": true,
            "requiredMessage": "Select a media scene.",
            "sync": [
              "params.sceneId"
            ],
            "col": "col-12 col-lg-8"
          }
        ]
      }
    },
    "media_stop_all": {
      "label": "Stop All Media",
      "params": [],
      "ui": {
        "module": "media",
        "pathKey": "media_stop_all",
        "actionLabel": "Stop All Media"
      }
    },
    "led_pattern": {
      "label": "LED Pattern",
      "params": [
        "group",
        "pattern",
        "durationMs"
      ],
      "planned": true
    },
    "delay": {
      "label": "Delay",
      "params": [
        "durationMs"
      ],
      "planned": true,
      "ui": {
        "module": "system",
        "pathKey": "system_delay",
        "actionLabel": "Delay"
      }
    },
    "set_lcd_text": {
      "label": "Set LCD Text",
      "params": [
        "device",
        "line1",
        "line2",
        "clearFirst"
      ],
      "targetSource": "hardware.lcds",
      "ui": {
        "module": "system",
        "pathKey": "system_lcd_text",
        "actionLabel": "LCD Text",
        "fields": [
          {
            "bind": "target",
            "label": "LCD Device",
            "kind": "select",
            "source": "hardware.lcds",
            "required": true,
            "requiredMessage": "Select an LCD device.",
            "placeholder": "Select LCD…",
            "sync": [
              "params.device",
              "params.lcdId"
            ],
            "col": "col-12 col-lg-4"
          },
          {
            "bind": "params.line1",
            "label": "Line 1",
            "kind": "text",
            "maxLength": 16,
            "col": "col-12 col-lg-4"
          },
          {
            "bind": "params.line2",
            "label": "Line 2",
            "kind": "text",
            "maxLength": 16,
            "col": "col-12 col-lg-4"
          },
          {
            "bind": "params.clearFirst",
            "label": "Clear display before writing",
